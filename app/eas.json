{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "github-release": {
      "environment": "production",
      "bun": "1.4.4",
      "env": {
        "NODE_ENV": "production"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "channel": "production",
      "autoIncrement": true
    }
  }
}
