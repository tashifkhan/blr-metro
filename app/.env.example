# Optional API override for native development. Use an origin, without /api/v1.
# Native builds default to https://blr-metro.vercel.app.
# Web builds use the page origin when this variable is unset.

# iOS simulator or local browser with a separate API process:
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8091

# Android emulator:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8091

# Physical device on the same network:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8091
