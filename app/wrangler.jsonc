{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blr-metro",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/docs", "/redoc", "/openapi.json"]
  },
  "vars": {
    "API_ORIGIN": "http://127.0.0.1:8091"
  },
  "observability": {
    "enabled": true
  }
}
